# URL base del backend de PharmaTrace (sin barra final).
# Es la API REST (puerto 3001 por defecto), NO el nodo de Hardhat (:8545).
VITE_API_URL=http://localhost:3001

# Valor de API_KEY de backend/.env (lo genera `npm run deploy:all`). El backend la exige en las
# escrituras salvo que corra con AUTH_DISABLED=true.
# OJO: todo lo que empieza con VITE_ queda visible en el bundle del navegador.
# Usalo solo en desarrollo local; en un deploy real la clave no puede vivir en el front.
VITE_API_KEY=
