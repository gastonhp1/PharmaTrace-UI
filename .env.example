# URL base de la API REST de PharmaTrace sobre Fabric (backend/, sin barra final).
# Es el puerto de la API (3001 por defecto), no un peer de Fabric.
VITE_API_URL=http://localhost:3001

# OPCIONAL, solo para desarrollo local: valor de API_KEY del backend, para no tener que cargarlo
# a mano en cada pestaña. Todo lo que empieza con VITE_ queda visible en el bundle del navegador,
# así que en un deploy real dejalo vacío: la clave se carga en runtime con el botón de la llave
# del menú (queda en sessionStorage, solo en esa pestaña).
VITE_API_KEY=
